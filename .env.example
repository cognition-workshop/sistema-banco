# Django Secret Key - REQUIRED in production
# Generate a new one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Debug mode - should be False in production
DEBUG=False

# Allowed hosts - comma-separated list of domains/IPs
ALLOWED_HOSTS=localhost,127.0.0.1,yourdomain.com

# Redis connection URL for Celery
REDIS_URL=redis://localhost:6379

# Security Headers - Enable in production
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
X_FRAME_OPTIONS=DENY
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
