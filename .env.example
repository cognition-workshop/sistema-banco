# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration
# For PostgreSQL: postgres://user:password@host:port/dbname
# For MySQL: mysql://user:password@host:port/dbname
# Leave empty to use SQLite (development only)
DATABASE_URL=

# Celery/Redis Configuration
# Use rediss:// for TLS/SSL in production
CELERY_BROKER_URL=rediss://username:password@redis-host:6380
CELERY_RESULT_BACKEND=rediss://username:password@redis-host:6380
