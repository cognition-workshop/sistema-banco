# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here-generate-with-get_random_secret_key
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com

# Database Configuration (PostgreSQL example)
DB_ENGINE=django.db.backends.postgresql
DB_NAME=banking_system_prod
DB_USER=banking_user
DB_PASSWORD=secure-password-here
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=600

# Redis/Celery Configuration
CELERY_BROKER_URL=redis://:password@localhost:6379/0
CELERY_RESULT_BACKEND=redis://:password@localhost:6379/1

# Business Rules (optional overrides)
MINIMUM_DEPOSIT_AMOUNT=10
MINIMUM_WITHDRAWAL_AMOUNT=10

# Security Settings (for production with HTTPS)
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True
SECURE_HSTS_SECONDS=31536000
SECURE_HSTS_INCLUDE_SUBDOMAINS=True
SECURE_HSTS_PRELOAD=True
