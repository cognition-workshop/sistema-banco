# Django Settings
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=False
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database Configuration
# Options: sqlite3 (default), postgresql, mysql
DB_ENGINE=postgresql

# PostgreSQL/MySQL Settings (only needed if DB_ENGINE is not sqlite3)
DB_NAME=banking_system
DB_USER=your_db_user
DB_PASSWORD=your_db_password
DB_HOST=localhost
DB_PORT=5432

# Celery/Redis Configuration
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Example configurations:
# 
# Development (SQLite):
# DB_ENGINE=sqlite3
# DEBUG=True
# SECRET_KEY=dev-secret-key
# ALLOWED_HOSTS=
# 
# Production (PostgreSQL):
# DB_ENGINE=postgresql
# DB_NAME=banking_prod
# DB_USER=banking_user
# DB_PASSWORD=secure_password_here
# DB_HOST=db.example.com
# DB_PORT=5432
# DEBUG=False
# SECRET_KEY=production-secret-key-minimum-50-chars-random
# ALLOWED_HOSTS=banking.example.com,www.banking.example.com
