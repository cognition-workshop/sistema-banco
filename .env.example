# Django Settings
# SECURITY WARNING: Generate a new secret key for production!
# You can generate one using: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-this-in-production

# Debug mode - MUST be False in production for security
# Set to True only for local development
DEBUG=True

# Allowed hosts - comma-separated list of domains/IPs that can serve this application
# Examples: example.com,www.example.com or * for all (not recommended in production)
# For local development: localhost,127.0.0.1
ALLOWED_HOSTS=localhost,127.0.0.1

# Celery & Redis Configuration
# Redis broker URL for Celery task queue
# Format: redis://[password@]host:port/db
# For production with auth: redis://:your-password@redis-host:6379/0
# For local development: redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379

# Redis backend URL for Celery results
# Same format as CELERY_BROKER_URL
# Should typically match CELERY_BROKER_URL
CELERY_RESULT_BACKEND=redis://localhost:6379

# Production Security Notes:
# When DEBUG=False, the following security headers are automatically enabled:
# - SECURE_SSL_REDIRECT: Redirects all HTTP to HTTPS
# - SECURE_HSTS_SECONDS: Enforces HTTPS for 1 year
# - SESSION_COOKIE_SECURE: Cookies only sent over HTTPS
# - CSRF_COOKIE_SECURE: CSRF cookies only sent over HTTPS
# - X_FRAME_OPTIONS: Prevents clickjacking attacks
