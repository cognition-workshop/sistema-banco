# Django Settings
# Generate a new secret key for production: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Set to True only for development, False for production
DEBUG=False

# Comma-separated list of allowed hosts (e.g., example.com,www.example.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis/Celery Settings
# Format: redis://host:port or redis://username:password@host:port
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Security Headers (enable these in production)
# Redirect all HTTP requests to HTTPS
SECURE_SSL_REDIRECT=False

# Only send cookies over HTTPS
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HTTP Strict Transport Security
# Set to 31536000 (1 year) in production
SECURE_HSTS_SECONDS=0
SECURE_HSTS_INCLUDE_SUBDOMAINS=False
SECURE_HSTS_PRELOAD=False

# Additional security headers
SECURE_CONTENT_TYPE_NOSNIFF=True
SECURE_BROWSER_XSS_FILTER=True
X_FRAME_OPTIONS=DENY
