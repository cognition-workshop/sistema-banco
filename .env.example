# Django Core Settings
# REQUIRED: Generate a secure secret key for production
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here

# Debug mode - should be False in production
# Default: False
DEBUG=False

# Allowed hosts - comma-separated list of domains
# Example: example.com,www.example.com,api.example.com
# Default: empty (will need to be set when DEBUG=False)
ALLOWED_HOSTS=localhost,127.0.0.1

# Celery / Redis Configuration
# Redis broker URL - supports authentication: redis://username:password@host:port/db
# Default: redis://localhost:6379
CELERY_BROKER_URL=redis://localhost:6379

# Redis result backend URL
# Default: redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Security Headers for Production
# These settings enhance security when serving over HTTPS

# Send CSRF cookie only over HTTPS (should be True in production)
# Default: opposite of DEBUG (True when DEBUG=False)
CSRF_COOKIE_SECURE=True

# Send session cookie only over HTTPS (should be True in production)
# Default: opposite of DEBUG (True when DEBUG=False)
SESSION_COOKIE_SECURE=True

# Redirect all HTTP requests to HTTPS
# Default: False
SECURE_SSL_REDIRECT=True

# HTTP Strict Transport Security (HSTS) - time in seconds
# Recommended: 31536000 (1 year) for production
# Default: 0 (disabled)
SECURE_HSTS_SECONDS=31536000

# Include subdomains in HSTS policy
# Default: False
SECURE_HSTS_INCLUDE_SUBDOMAINS=True

# Allow browser HSTS preload list submission
# Default: False
SECURE_HSTS_PRELOAD=True

# Prevent MIME type sniffing
# Default: True
SECURE_CONTENT_TYPE_NOSNIFF=True

# Enable browser XSS filter
# Default: True
SECURE_BROWSER_XSS_FILTER=True

# X-Frame-Options header to prevent clickjacking
# Options: DENY, SAMEORIGIN
# Default: DENY
X_FRAME_OPTIONS=DENY
