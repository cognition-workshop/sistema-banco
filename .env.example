# Django Settings
# SECURITY WARNING: Generate a new SECRET_KEY for production!
# You can generate one with: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-generate-a-new-one-for-production

# Set to False in production
DEBUG=False

# Comma-separated list of allowed hosts (e.g., localhost,127.0.0.1,yourdomain.com)
ALLOWED_HOSTS=localhost,127.0.0.1

# Redis/Celery Settings
# Format: redis://[username:password@]host:port[/db]
CELERY_BROKER_URL=redis://localhost:6379
CELERY_RESULT_BACKEND=redis://localhost:6379

# Security Headers (optional, defaults provided)
# HSTS: HTTP Strict Transport Security - tells browsers to only use HTTPS (1 year = 31536000 seconds)
SECURE_HSTS_SECONDS=31536000
