# ============================================
# Django Banking System - Environment Variables
# ============================================
#
# This file documents all environment variables used by the application.
# Copy this file to .env and configure with your actual values.
#
# SECURITY WARNING: Never commit your actual .env file to version control!
#

# ============================================
# Core Django Settings
# ============================================

# SECRET_KEY: Used for cryptographic signing (sessions, CSRF, etc.)
# REQUIRED in production - must be unique and kept secret
# Generate one: python -c 'from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())'
SECRET_KEY=your-secret-key-here-change-in-production

# DEBUG: Enable detailed error pages (True) or generic error pages (False)
# ALWAYS set to False in production for security
# Default: False (if not set)
DEBUG=True

# ALLOWED_HOSTS: Comma-separated list of domain names that can serve this app
# REQUIRED in production - prevents host header attacks
# Example: example.com,www.example.com,api.example.com
# Default: localhost,127.0.0.1 (for development)
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# Celery/Redis Settings
# ============================================

# CELERY_BROKER_URL: Redis URL for Celery task queue
# For production with authentication: redis://:password@host:port/db
# For production without auth: redis://host:port/db
# Default: redis://localhost:6379 (for development)
CELERY_BROKER_URL=redis://localhost:6379

# CELERY_RESULT_BACKEND: Redis URL for storing task results
# Should match CELERY_BROKER_URL in most cases
# Default: redis://localhost:6379 (for development)
CELERY_RESULT_BACKEND=redis://localhost:6379

# ============================================
# Production Security Settings
# ============================================
#
# These settings should be enabled (set to True) when deploying to production
# with HTTPS enabled. They enhance security but require proper SSL setup.
#

# SECURE_SSL_REDIRECT: Redirect all HTTP requests to HTTPS
# Set to True in production, False for local development
# Default: False
SECURE_SSL_REDIRECT=False

# SESSION_COOKIE_SECURE: Only send session cookies over HTTPS
# Set to True in production, False for local development
# Default: False
SESSION_COOKIE_SECURE=False

# CSRF_COOKIE_SECURE: Only send CSRF cookies over HTTPS
# Set to True in production, False for local development
# Default: False
CSRF_COOKIE_SECURE=False

# SECURE_BROWSER_XSS_FILTER: Enable browser XSS filtering
# Recommended: True (enabled by default)
# Default: True
SECURE_BROWSER_XSS_FILTER=True

# SECURE_CONTENT_TYPE_NOSNIFF: Prevent MIME type sniffing
# Recommended: True (enabled by default)
# Default: True
SECURE_CONTENT_TYPE_NOSNIFF=True

# X_FRAME_OPTIONS: Prevent clickjacking attacks
# Options: DENY, SAMEORIGIN, or ALLOW-FROM uri
# Recommended: DENY
# Default: DENY
X_FRAME_OPTIONS=DENY

# SECURE_HSTS_SECONDS: HTTP Strict Transport Security max-age in seconds
# Set to 31536000 (1 year) in production after testing
# Set to 0 for local development
# Default: 0
SECURE_HSTS_SECONDS=0

# SECURE_HSTS_INCLUDE_SUBDOMAINS: Apply HSTS to all subdomains
# Set to True in production if all subdomains use HTTPS
# Default: False
SECURE_HSTS_INCLUDE_SUBDOMAINS=False

# SECURE_HSTS_PRELOAD: Submit site to HSTS preload list
# Only enable after HSTS_SECONDS is set to 1 year and fully tested
# Default: False
SECURE_HSTS_PRELOAD=False
