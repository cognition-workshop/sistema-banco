[flake8]
max-line-length = 120
exclude =
    .git,
    __pycache__,
    */migrations/*,
    venv,
    env,
    .venv,
    .env
ignore =
    E203,
    E501,
    W503,
    W504,
per-file-ignores =
    __init__.py:F401
    accounts/models.py:E226
    accounts/tests.py:F401
    core/admin.py:F401
    core/models.py:F401
    core/tests.py:F401
    transactions/tests.py:F401
